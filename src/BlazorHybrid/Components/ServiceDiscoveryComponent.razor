@using BlazorHybrid.ViewModels
@using Dev.JoshBrunton.DynamicsEndpointDiscovery.Application.Enums
@inject IServiceDiscoveryViewModel ViewModel

<div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);">
    <FluentWizard Width="500px"
                  StepperPosition="StepperPosition.Top"
                  DisplayStepNumber="@(WizardStepStatus.Current | WizardStepStatus.Next)"
                  Border="WizardBorder.Outside"
                  OnFinish="ViewModel.DiscoverServices">
        <Steps>
            <FluentWizardStep Label="Authenticate with Dynamics 365">
                <FluentTextField style="width: 100%;" Label="Client ID" @bind-Value="ViewModel.ClientId" />
                <FluentTextField style="width: 100%;" Label="Client secret" TextFieldType="TextFieldType.Password" @bind-Value="ViewModel.ClientSecret" />
                <FluentTextField style="width: 100%;" Label="Token request endpoint" @bind-Value="ViewModel.TokenRequestEndpoint" />
                <FluentTextField style="width: 100%;" Label="Resource" @bind-Value="ViewModel.Resource" />
            </FluentWizardStep>

            <FluentWizardStep Label="Filter redundant resources">
                <FluentTextField style="width: 100%;" Label="Groups filter" @bind-Value="ViewModel.GrepGroups" />
                <FluentTextField style="width: 100%;" Label="Services filter" @bind-Value="ViewModel.GrepServices" />
                <FluentTextField style="width: 100%;" Label="Operations filter" @bind-Value="ViewModel.GrepOperations" />
            </FluentWizardStep>

            <FluentWizardStep Label="Choose output format">
                <FluentSelect TOption="OutputSchemas"
                              Label="Schema"
                              Items="ViewModel.OutputSchemaOptions"
                              @bind-SelectedOption="@ViewModel.OutputSchema" />

                <FluentSelect TOption="OutputFormats"
                              Label="Format"
                              Items="ViewModel.OutputFormatOptions"
                              @bind-SelectedOption="@ViewModel.OutputFormat" />

                <FluentTextField style="width: 100%;" Label="Collection name" @bind-Value="ViewModel.CollectionName" />

                <FluentCheckbox Style="margin-top: .5em;" @bind-Value="ViewModel.Minify" Label="Minify" />

                @if (ViewModel.IsLoading)
                {
                    <FluentStack Orientation="Orientation.Horizontal">
                        <FluentSpacer />
                        <FluentProgressRing />
                    </FluentStack>
                }
            </FluentWizardStep>
        </Steps>
    </FluentWizard>
</div>
