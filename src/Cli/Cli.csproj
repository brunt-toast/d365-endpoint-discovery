<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dynsvcdiscovery</ToolCommandName>
    <PackageOutputPath>./bin/nupkg</PackageOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>dynsvcdiscovery</PackageId>
    <PackageVersion>$(Version)</PackageVersion>
    <Authors>Josh Brunton</Authors>
    <Description>Discover Dynamics 365 Service Endpoints</Description>
    <Copyright>Josh Brunton 2025</Copyright>
    <PackageProjectUrl>https://github.com/brunt-toast/d365-endpoint-discovery</PackageProjectUrl>
    <PackageIcon></PackageIcon>
    <RepositoryUrl>https://github.com/brunt-toast/d365-endpoint-discovery</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>cli tool dynamics dynamics-365 d365 ax</PackageTags>
    <PackageReleaseNotes></PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0-rc.1.25451.107" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Application\Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/Languages/*.resx">
      <Generator>MSBuild:Compile</Generator>
      <LastGenOutput>%(Filename).Designer.cs</LastGenOutput>
      <StronglyTypedFileName>$(MSBuildProjectDirectory)\Resources\Languages\%(Filename).Designer.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>$(RootNamespace).Resources.Languages</StronglyTypedNamespace>
      <StronglyTypedClassName>%(Filename)</StronglyTypedClassName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
