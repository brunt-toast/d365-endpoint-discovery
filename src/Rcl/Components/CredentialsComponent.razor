@using Dev.JoshBrunton.DynamicsEndpointDiscovery.Lib.Ax.Enums
@using Dev.JoshBrunton.DynamicsEndpointDiscovery.Rcl.Components.Icons
@using Dev.JoshBrunton.DynamicsEndpointDiscovery.Rcl.ViewModels
@using Microsoft.FluentUI.AspNetCore.Components.Icons.Filled

<FluentSelect TOption="AuthKind"
              Label="Authentication"
              style="width: 100%;"
              @bind-SelectedOption="ViewModel.AuthKind"
              Items="Enum.GetValues<AuthKind>().Where(x => x != AuthKind.BestGuess)" />

@switch (ViewModel.AuthKind)
{
    case AuthKind.Application:
        <FluentTextField style="width: 100%;" Label="Client ID" @bind-Value="ViewModel.ClientId" />
        <FluentTextField style="width: 100%;" Label="Client secret" TextFieldType="TextFieldType.Password" @bind-Value="ViewModel.ClientSecret" />
        <FluentTextField style="width: 100%;" Label="Token request endpoint" @bind-Value="ViewModel.TokenRequestEndpoint" />
        <FluentTextField style="width: 100%;" Label="Resource" @bind-Value="ViewModel.ResourceUri" />
        break;
    case AuthKind.User:
        <FluentTextField style="width: 100%;" Label="Client ID" @bind-Value="ViewModel.ClientId" />
        <FluentTextField style="width: 100%;" Label="Tenant ID" @bind-Value="ViewModel.TenantId" />
        <FluentTextField style="width: 100%;" Label="Resource" @bind-Value="ViewModel.ResourceUri" />
        <FluentStack Orientation="Orientation.Horizontal">
            <FluentSpacer />
            <p>You'll be prompted to log in on the next screen.</p>
            <FluentSpacer />
        </FluentStack>
        break;
    case AuthKind.BestGuess:
    default:
        <p>
            @ViewModel.AuthKind is not yet supported.
        </p>
        break;
}

<FluentStack Orientation="Orientation.Horizontal" Style="margin-top: 0.5em;">

    <FluentButton IconStart="IconRepository.Remember"
                  Id="rememberQuestion"
                  OnClick="@(() => ViewModel.CacheCredentials = !ViewModel.CacheCredentials)"
                  Appearance="@(ViewModel.CacheCredentials ? Appearance.Accent : Appearance.Outline)">
        Remember
    </FluentButton>

    <FluentButton IconStart="IconRepository.Certificate"
                  Id="ignoreSslQuestion"
                  OnClick="@(() => ViewModel.IgnoreSsl = !ViewModel.IgnoreSsl)"
                  Appearance="@(ViewModel.IgnoreSsl ? Appearance.Accent : Appearance.Outline)">
        Ignore SSL
    </FluentButton>
    
    <FluentNumberField TValue="int"
                       Id="maxConnectionsQuestion"
                       Placeholder="@("\u221e")"
                       @bind-Value="ViewModel.MaxConnections"
                       Style="width: 8em;">
        <FluentIcon Icon="Size20.Link" Slot="start" />
    </FluentNumberField>
    
    @if (ViewModel.AuthKind is AuthKind.User)
    {
        <FluentButton IconStart="IconRepository.Download" OnClick="ViewModel.LoadProfileAsync">Import</FluentButton>
        <FluentButton IconStart="IconRepository.Upload" OnClick="ViewModel.SaveProfileAsync">Export</FluentButton>
    }
</FluentStack>

<FluentTooltip Anchor="rememberQuestion"
               Delay="100"
               MaxWidth="300px"
               Position="TooltipPosition.Top">
    Save these credentials so they'll be here next time you launch the app.
    All data is stored securely by the operating system.
</FluentTooltip>

<FluentTooltip Anchor="ignoreSslQuestion"
               Delay="100"
               MaxWidth="300px"
               Position="TooltipPosition.Top">
    Disable SSL checks when exploring the Dynamics instance.
    This is insecure! SSL will always be enabled when getting a
    bearer token.
</FluentTooltip>

<FluentTooltip Anchor="maxConnectionsQuestion"
               Delay="100"
               MaxWidth="300px"
               Position="TooltipPosition.Top">
    Limit the number of connections made at any given time.
    This helps to avoid socket exhaustion for large jobs,
    but causes a significant performance hit.
</FluentTooltip>

@code
{
    [Parameter] public ICredentialsViewModel ViewModel { get; set; } = null!;
}
