@using Dev.JoshBrunton.DynamicsEndpointDiscovery.Lib.Ax.Enums
@using Dev.JoshBrunton.DynamicsEndpointDiscovery.Rcl.Components.Icons
@using Dev.JoshBrunton.DynamicsEndpointDiscovery.Rcl.Resources.Languages
@using Dev.JoshBrunton.DynamicsEndpointDiscovery.Rcl.Services
@using Dev.JoshBrunton.DynamicsEndpointDiscovery.Rcl.ViewModels
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<CredentialsComponentResources> Localizer
@inject ICultureService CultureService

@if (ViewModel.IsLoading)
{
    <FluentStack Orientation="Orientation.Horizontal">
        <FluentSpacer />
        <FluentProgressRing />
        <FluentSpacer />
    </FluentStack>
    return;
}

<FluentSelect TOption="AuthKind"
              Label="@CredentialsComponentResources.Authentication"
              OptionText="CultureService.LocaliseEnum<AuthKind,AuthKindResources>"
              style="width: 100%;"
              @bind-SelectedOption="ViewModel.AuthKind" 
              Items="Enum.GetValues<AuthKind>().Where(x => x != AuthKind.BestGuess)" />

@switch (ViewModel.AuthKind)
{
    case AuthKind.Application:
        <FluentTextField style="width: 100%;" Label="@CredentialsComponentResources.ClientId" @bind-Value="ViewModel.ClientId" />
        <FluentTextField style="width: 100%;" Label="@CredentialsComponentResources.ClientSecret" TextFieldType="TextFieldType.Password" @bind-Value="ViewModel.ClientSecret" />
        <FluentTextField style="width: 100%;" Label="@CredentialsComponentResources.TokenRequestEndpoint" @bind-Value="ViewModel.TokenRequestEndpoint" />
        <FluentTextField style="width: 100%;" Label="@CredentialsComponentResources.ResourceUri" @bind-Value="ViewModel.ResourceUri" />
        break;
    case AuthKind.User:
        <FluentTextField style="width: 100%;" Label="@CredentialsComponentResources.ClientId" @bind-Value="ViewModel.ClientId" />
        <FluentTextField style="width: 100%;" Label="@CredentialsComponentResources.TenantId" @bind-Value="ViewModel.TenantId" />
        <FluentTextField style="width: 100%;" Label="@CredentialsComponentResources.ResourceUri" @bind-Value="ViewModel.ResourceUri" />
        <FluentStack Orientation="Orientation.Horizontal">
            <FluentSpacer />
            <p>@CredentialsComponentResources.NextScreenLoginPromptInfo</p>
            <FluentSpacer />
        </FluentStack>
        break;
    case AuthKind.BestGuess:
    default:
        <p>
            @Localizer[CredentialsComponentResources.AuthKindNotSupported, ViewModel.AuthKind]
        </p>
        break;
}

<FluentStack Orientation="Orientation.Horizontal" Style="margin-top: 0.5em;">

    <FluentButton IconStart="IconRepository.Remember"
                  Id="rememberQuestion"
                  OnClick="@(() => ViewModel.CacheCredentials = !ViewModel.CacheCredentials)"
                  Appearance="@(ViewModel.CacheCredentials ? Appearance.Accent : Appearance.Outline)">
        @CredentialsComponentResources.Remember
    </FluentButton>

    @if (ViewModel.AuthKind is AuthKind.User)
    {
        <FluentButton IconStart="IconRepository.Download" OnClick="ViewModel.LoadProfileAsync">
            @CredentialsComponentResources.Import
        </FluentButton>
        <FluentButton IconStart="IconRepository.Upload" OnClick="ViewModel.SaveProfileAsync">
            @CredentialsComponentResources.Export
        </FluentButton>
    }
</FluentStack>

<FluentTooltip Anchor="rememberQuestion"
               Delay="100"
               MaxWidth="300px"
               Position="TooltipPosition.Top">
    @CredentialsComponentResources.RememberHelp
</FluentTooltip>

@code
{
    [Parameter] public ICredentialsViewModel ViewModel { get; set; } = null!;
}
