@using Dev.JoshBrunton.DynamicsEndpointDiscovery.Rcl.Resources.Languages
@using Dev.JoshBrunton.DynamicsEndpointDiscovery.Rcl.ViewModels
@using Dev.JoshBrunton.DynamicsEndpointDiscovery.Rcl.Extensions.System

@if (ViewModel.IsLoading)
{
    <FluentStack Orientation="Orientation.Horizontal">
        <FluentSpacer />
        <FluentProgressRing />
        <FluentSpacer />
    </FluentStack>
    <FluentStack Orientation="Orientation.Horizontal">
        <FluentSpacer />
        <p>This might take a while...</p>
        <FluentSpacer />
    </FluentStack>
    return;
}

<FluentStack Orientation="Orientation.Vertical">
    <FluentTextField Style="width: 100%;" Label="@BuildCollectionComponentResources.CollectionName" @bind-Value="ViewModel.CollectionName" />
    <FluentCombobox Label="@BuildCollectionComponentResources.Schema" Items="ViewModel.AvailableOutputSchemas" OptionText="EnumExtensions.OutputSchemasToDisplayName" @bind-SelectedOption="ViewModel.OutputSchema" />
    <FluentCombobox Label="@BuildCollectionComponentResources.Format" Items="ViewModel.AvailableOutputFormats" OptionText="EnumExtensions.OutputFormatsToDisplayName" @bind-SelectedOption="ViewModel.OutputFormat" />
    <FluentCheckbox Label="@BuildCollectionComponentResources.Minify" @bind-Value="ViewModel.Minify" />
</FluentStack>

@code
{
    [Parameter] public IBuildCollectionViewModel ViewModel { get; set; } = null!;
}
