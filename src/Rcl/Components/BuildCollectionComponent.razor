@using Dev.JoshBrunton.DynamicsEndpointDiscovery.Rcl.Resources.Languages
@using Dev.JoshBrunton.DynamicsEndpointDiscovery.Rcl.ViewModels
<FluentStack Orientation="Orientation.Vertical">
    <FluentTextField Style="width: 100%;" Label="@BuildCollectionComponentResources.CollectionName" @bind-Value="ViewModel.CollectionName" />
    <FluentCombobox Label="@BuildCollectionComponentResources.Schema" Items="ViewModel.AvailableOutputSchemas" @bind-SelectedOption="ViewModel.OutputSchema" />
    <FluentCombobox Label="@BuildCollectionComponentResources.Format" Items="ViewModel.AvailableOutputFormats" @bind-SelectedOption="ViewModel.OutputFormat" />
    <FluentCheckbox Label="@BuildCollectionComponentResources.Minify" @bind-Value="ViewModel.Minify" />
</FluentStack>

@code 
{
    [Parameter] public IBuildCollectionViewModel ViewModel { get; set; } = null!;
}